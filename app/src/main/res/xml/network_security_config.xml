<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 does not know Let's Encrypt's ISRG Root X1 (7.1.1 and newer do): without it the Lossless server and GitHub fail to connect. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
