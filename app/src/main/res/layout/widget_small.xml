<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 1: cover, song, artist, play-pause, next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root" android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="10dp" android:paddingEnd="12dp" android:paddingVertical="8dp" android:clipToOutline="true">
    <ImageView android:id="@id/widget_cover" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:background="@drawable/widget_cover_bg"
        android:clipToOutline="true" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@id/widget_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
        android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:src="@drawable/widget_play" android:contentDescription="Play" />
    <ImageView android:id="@id/widget_next" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
        android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:src="@drawable/widget_next" android:contentDescription="Next" />
</LinearLayout>
